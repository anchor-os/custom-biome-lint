{
  "name": "custom-biome-lint",
  "version": "0.1.0",
  "description": "Standalone linting tool for Reselect/Redux patterns not in Biome",
  "bin": {
    "custom-biome-lint": "bin/cli.js"
  },
  "scripts": {
    "build": "cargo build --release",
    "postinstall": "cargo build --release",
    "test": "cargo test",
    "lint": "cargo clippy"
  },
  "files": [
    "bin",
    "src",
    "Cargo.toml",
    "Cargo.lock",
    "README.md"
  ],
  "keywords": [
    "lint",
    "biome",
    "reselect",
    "redux",
    "immutable"
  ],
  "license": "MIT"
}
