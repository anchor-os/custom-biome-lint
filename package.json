{
  "name": "custom-biome-lint",
  "version": "0.4.3",
  "description": "Standalone linting tool for Reselect/Redux patterns not in Biome",
  "bin": {
    "custom-biome-lint": "bin/cli.js"
  },
  "scripts": {
    "build": "cargo build --release",
    "build:native": "cargo build --release",
    "dev:build": "cargo build",
    "test": "cargo test",
    "test:js": "node --test bin/*.test.js",
    "lint": "cargo clippy"
  },
  "files": [
    "bin/cli.js",
    "bin/platform.js",
    "README.md"
  ],
  "optionalDependencies": {
    "custom-biome-lint-darwin-arm64": "0.4.3",
    "custom-biome-lint-darwin-x64": "0.4.3",
    "custom-biome-lint-linux-arm64": "0.4.3",
    "custom-biome-lint-linux-arm64-musl": "0.4.3",
    "custom-biome-lint-linux-x64": "0.4.3",
    "custom-biome-lint-linux-x64-musl": "0.4.3",
    "custom-biome-lint-win32-arm64": "0.4.3",
    "custom-biome-lint-win32-x64": "0.4.3"
  },
  "keywords": [
    "lint",
    "biome",
    "reselect",
    "redux",
    "immutable"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anchor-os/custom-biome-lint.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
